{
  "manifest_version": 1,
  "type": "device",
  "name": "Amtrak",
  "description": {
    "en": "Amtrak, VIA Rail and Brightline trains in real time: delay, next stop, arrival at your station.",
    "fr": "Trains Amtrak, VIA Rail et Brightline en temps réel : retard, prochain arrêt, arrivée à votre gare.",
    "de": "Züge von Amtrak, VIA Rail und Brightline live: Verspätung, nächster Halt, Ankunft an deinem Bahnhof.",
    "es": "Trenes Amtrak, VIA Rail y Brightline en tiempo real: retraso, próxima parada, llegada a su estación."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-amtrak:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-amtrak/main/cover.png",
  "categories": ["transport"],
  "countries": ["US", "CA"],
  "keywords": ["train", "Amtrak", "VIA Rail", "Brightline", "railroad", "Amtraker"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Comment ça marche",
        "de": "So funktioniert es",
        "es": "Cómo funciona"
      },
      "description": {
        "en": "Watch a train by its number (and your station), or a station, with the actions below, then create its device in the Discover tab. Data from Amtraker (amtraker.com), a free community API: unofficial, not affiliated with Amtrak.",
        "fr": "Suivez un train par son numéro (et votre gare), ou une gare, avec les actions ci-dessous, puis créez son appareil dans l'onglet Découverte. Données d'Amtraker (amtraker.com), API communautaire gratuite : non officiel, sans lien avec Amtrak.",
        "de": "Verfolge einen Zug über seine Nummer (und deinen Bahnhof) oder einen Bahnhof mit den Aktionen unten und lege dann sein Gerät im Tab „Entdecken“ an. Daten von Amtraker (amtraker.com), einer freien Community-API: inoffiziell, nicht mit Amtrak verbunden.",
        "es": "Siga un tren por su número (y su estación), o una estación, con las acciones de abajo, y luego cree su dispositivo en la pestaña Descubrir. Datos de Amtraker (amtraker.com), una API comunitaria gratuita: no oficial, sin relación con Amtrak."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-amtrak/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Anleitung",
            "es": "Guía de instalación"
          }
        },
        {
          "url": "https://amtraker.com",
          "label": {
            "en": "Data: Amtraker",
            "fr": "Données : Amtraker",
            "de": "Daten: Amtraker",
            "es": "Datos: Amtraker"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Language of the feature names, of the states and of the sentences sent to your scenes. Feature names are set when a device is created.",
        "fr": "Langue des noms de fonctionnalités, des états et des phrases envoyées à vos scènes. Les noms sont fixés à la création de l'appareil.",
        "de": "Sprache der Funktionsnamen, der Zustände und der Sätze für deine Szenen. Die Namen werden beim Anlegen des Geräts festgelegt.",
        "es": "Idioma de los nombres de funciones, de los estados y de las frases enviadas a sus escenas. Los nombres se fijan al crear el dispositivo."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    },
    {
      "key": "refresh_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Fréquence de mise à jour",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often Amtraker is read for your created devices. Amtraker is a free service: keep it gentle.",
        "fr": "Fréquence de lecture d'Amtraker pour vos appareils créés. Amtraker est un service gratuit : restez raisonnable.",
        "de": "Wie oft Amtraker für deine angelegten Geräte gelesen wird. Amtraker ist ein freier Dienst: bleib maßvoll.",
        "es": "Frecuencia de lectura de Amtraker para sus dispositivos creados. Amtraker es un servicio gratuito: sea razonable."
      },
      "required": false,
      "default": "120",
      "options": [
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "2 minutes",
            "fr": "2 minutes",
            "de": "2 Minuten",
            "es": "2 minutos"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "add_train",
      "label": {
        "en": "Watch a train",
        "fr": "Suivre un train",
        "de": "Zug verfolgen",
        "es": "Seguir un tren"
      },
      "description": {
        "en": "Watches a train number: its device then appears in the Discover tab. With your station, also its arrival there.",
        "fr": "Suit un numéro de train : son appareil apparaît alors dans l'onglet Découverte. Avec votre gare, aussi son arrivée là.",
        "de": "Verfolgt eine Zugnummer: Sein Gerät erscheint dann im Tab „Entdecken“. Mit deinem Bahnhof auch die Ankunft dort.",
        "es": "Sigue un número de tren: su dispositivo aparece entonces en la pestaña Descubrir. Con su estación, también su llegada."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "train",
          "type": "string",
          "required": true,
          "label": {
            "en": "Train number",
            "fr": "Numéro du train",
            "de": "Zugnummer",
            "es": "Número de tren"
          },
          "description": {
            "en": "The number alone for Amtrak (5), with \"v\" for VIA Rail (v15) or \"b\" for Brightline (b5150).",
            "fr": "Le numéro seul pour Amtrak (5), avec « v » pour VIA Rail (v15) ou « b » pour Brightline (b5150).",
            "de": "Nur die Nummer für Amtrak (5), mit „v“ für VIA Rail (v15) oder „b“ für Brightline (b5150).",
            "es": "Solo el número para Amtrak (5), con «v» para VIA Rail (v15) o «b» para Brightline (b5150)."
          },
          "placeholder": {
            "en": "e.g. 5",
            "fr": "ex. 5",
            "de": "z. B. 5",
            "es": "p. ej. 5"
          }
        },
        {
          "key": "station",
          "type": "string",
          "required": false,
          "label": {
            "en": "Your station code (optional)",
            "fr": "Code de votre gare (facultatif)",
            "de": "Code deines Bahnhofs (optional)",
            "es": "Código de su estación (opcional)"
          },
          "description": {
            "en": "Adds the arrival time and the countdown at this station. Find the code with \"Find a station\".",
            "fr": "Ajoute l'heure d'arrivée et le compte à rebours à cette gare. Trouvez le code avec « Trouver une gare ».",
            "de": "Fügt Ankunftszeit und Countdown an diesem Bahnhof hinzu. Finde den Code mit „Bahnhof suchen“.",
            "es": "Añade la hora de llegada y la cuenta atrás en esta estación. Busque el código con «Buscar una estación»."
          },
          "placeholder": {
            "en": "e.g. EMY",
            "fr": "ex. EMY",
            "de": "z. B. EMY",
            "es": "p. ej. EMY"
          }
        }
      ]
    },
    {
      "key": "add_station",
      "label": {
        "en": "Watch a station",
        "fr": "Suivre une gare",
        "de": "Bahnhof verfolgen",
        "es": "Seguir una estación"
      },
      "description": {
        "en": "The next trains calling at a station, in a device of their own (Discover tab).",
        "fr": "Les prochains trains qui desservent une gare, dans un appareil à part (onglet Découverte).",
        "de": "Die nächsten Züge an einem Bahnhof, in einem eigenen Gerät (Tab „Entdecken“).",
        "es": "Los próximos trenes que paran en una estación, en un dispositivo propio (pestaña Descubrir)."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "station",
          "type": "string",
          "required": true,
          "label": {
            "en": "Station code",
            "fr": "Code de la gare",
            "de": "Bahnhofscode",
            "es": "Código de la estación"
          },
          "placeholder": {
            "en": "e.g. CHI",
            "fr": "ex. CHI",
            "de": "z. B. CHI",
            "es": "p. ej. CHI"
          }
        }
      ]
    },
    {
      "key": "find_station",
      "label": {
        "en": "Find a station",
        "fr": "Trouver une gare",
        "de": "Bahnhof suchen",
        "es": "Buscar una estación"
      },
      "description": {
        "en": "Lists the stations matching a name, a city or a code, with their code.",
        "fr": "Liste les gares qui correspondent à un nom, une ville ou un code, avec leur code.",
        "de": "Listet die Bahnhöfe zu einem Namen, einer Stadt oder einem Code auf, mit ihrem Code.",
        "es": "Lista las estaciones que coinciden con un nombre, una ciudad o un código, con su código."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "query",
          "type": "string",
          "required": true,
          "label": {
            "en": "Name, city or code",
            "fr": "Nom, ville ou code",
            "de": "Name, Stadt oder Code",
            "es": "Nombre, ciudad o código"
          },
          "placeholder": {
            "en": "e.g. Chicago",
            "fr": "ex. Chicago",
            "de": "z. B. Chicago",
            "es": "p. ej. Chicago"
          }
        }
      ]
    },
    {
      "key": "remove",
      "label": {
        "en": "Stop watching",
        "fr": "Ne plus suivre",
        "de": "Nicht mehr verfolgen",
        "es": "Dejar de seguir"
      },
      "description": {
        "en": "Stops watching a train or a station. Its device stays in Gladys until you delete it.",
        "fr": "Arrête de suivre un train ou une gare. Son appareil reste dans Gladys jusqu'à ce que vous le supprimiez.",
        "de": "Beendet das Verfolgen eines Zugs oder Bahnhofs. Sein Gerät bleibt in Gladys, bis du es löschst.",
        "es": "Deja de seguir un tren o una estación. Su dispositivo permanece en Gladys hasta que usted lo elimine."
      },
      "timeout_seconds": 15,
      "fields": [
        {
          "key": "name",
          "type": "string",
          "required": true,
          "label": {
            "en": "Name, number or code",
            "fr": "Nom, numéro ou code",
            "de": "Name, Nummer oder Code",
            "es": "Nombre, número o código"
          },
          "placeholder": {
            "en": "e.g. 5 or CHI",
            "fr": "ex. 5 ou CHI",
            "de": "z. B. 5 oder CHI",
            "es": "p. ej. 5 o CHI"
          }
        }
      ]
    },
    {
      "key": "status",
      "label": {
        "en": "Show what is watched",
        "fr": "Afficher les suivis",
        "de": "Verfolgte Einträge anzeigen",
        "es": "Mostrar los seguimientos"
      },
      "description": {
        "en": "The watched trains and stations, their devices and the last read from Amtraker.",
        "fr": "Les trains et gares suivis, leurs appareils et la dernière lecture d'Amtraker.",
        "de": "Die verfolgten Züge und Bahnhöfe, ihre Geräte und die letzte Abfrage bei Amtraker.",
        "es": "Los trenes y estaciones seguidos, sus dispositivos y la última lectura de Amtraker."
      },
      "timeout_seconds": 30
    }
